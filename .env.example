# ==============================================================================
# GB STUDIO - Production Environment Configuration
# ==============================================================================

# --- Django Core Settings ---
# Generate a secret key with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=change-this-to-a-very-long-and-random-secret-key-in-production
DEBUG=False

# Comma-separated allowed hostnames and IP addresses
ALLOWED_HOSTS=gb-studio.art,www.gb-studio.art,127.0.0.1,localhost

# CSRF Trusted origins (required for Django 4.0+ when running behind HTTPS reverse proxy)
CSRF_TRUSTED_ORIGINS=https://gb-studio.art,https://www.gb-studio.art

# Set to true to automatically create admin user (admin / admin2026) and initial categories/cases on first start
AUTO_SEED_DB=true

# --- PostgreSQL Database Configuration ---
POSTGRES_DB=popikin_db
POSTGRES_USER=popikin_user
POSTGRES_PASSWORD=generate_a_strong_password_here_min_16_chars
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Production Domain & SSL (Let's Encrypt) Settings ---
# Primary domain for the website (without www or https://)
DOMAIN_NAME=gb-studio.art

# Contact email for Let's Encrypt certificate renewal notices
CERTBOT_EMAIL=info@gb-studio.art
